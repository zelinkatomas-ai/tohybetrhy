---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
const dateStr = new Date(frontmatter.date).toLocaleDateString('cs-CZ');
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <article>
    <header>
      <h1>{frontmatter.title}</h1>
      <p class="meta">{dateStr}</p>
    </header>
    <slot />
  </article>

  <style>
    article { max-width: 46rem; margin: 0 auto; }
    article :global(figure.viz) { max-width: none; }
    h1 { font-size: 1.6rem; line-height: 1.3; margin-bottom: 0.25rem; }
    .meta { color: var(--text-muted); font-size: 0.85rem; margin-top: 0; }
    article :global(h2) { font-size: 1.2rem; margin-top: 2rem; }
    article :global(p) { color: var(--text-secondary); }
    article :global(a) { color: var(--accent); }
  </style>
</Base>
