---
/**
 * Detail ETF: /etf/<slug>/ (např. /etf/spmo/, /etf/iemo-mi/).
 * Data = řádek z příslušné skupiny + popis z src/config/etf-info.json.
 */
import Base from '../../layouts/Base.astro';
import Methodology from '../../components/Methodology.astro';
import regions from '../../data/regions.json';
import regionsEurope from '../../data/regions_europe.json';
import regionsAsia from '../../data/regions_asia.json';
import sectors from '../../data/sectors.json';
import crypto from '../../data/crypto.json';
import momentumEtfs from '../../data/momentum_etfs.json';
import info from '../../config/etf-info.json';
import { etfSlug, fmtPct } from '../../lib/utils';

export function getStaticPaths() {
  const all = [
    ...regions.rows.map((r) => ({ ...r, group: 'Regiony', backHref: '/regiony/', backLabel: 'Momentum regionů' })),
    ...regionsEurope.rows.map((r) => ({ ...r, group: 'Regiony', backHref: '/regiony/', backLabel: 'Momentum regionů' })),
    ...regionsAsia.rows.map((r) => ({ ...r, group: 'Regiony', backHref: '/regiony/', backLabel: 'Momentum regionů' })),
    ...sectors.rows.map((r) => ({ ...r, group: 'Sektory', backHref: '/sektory/', backLabel: 'Momentum sektorů' })),
    ...crypto.rows.map((r) => ({ ...r, group: 'Krypto', backHref: '/sektory/', backLabel: 'Momentum sektorů' })),
    ...momentumEtfs.rows.map((r) => ({ ...r, group: 'Momentum ETF', backHref: '/momentum-etf/', backLabel: 'Momentum ETF' })),
  ];
  // stejný ticker může být jen v jedné skupině; kdyby ne, vyhraje první výskyt
  const seen = new Set<string>();
  return all
    .filter((r) => !seen.has(r.ticker) && seen.add(r.ticker))
    .map((row) => ({ params: { ticker: etfSlug(row.ticker) }, props: { row } }));
}

const { row } = Astro.props;
const meta = (info as Record<string, any>)[row.ticker] ?? {};
const updatedSource =
  row.group === 'Regiony' ? regions
  : row.group === 'Sektory' ? sectors
  : row.group === 'Krypto' ? crypto
  : momentumEtfs;
const updated = new Date(updatedSource.updated).toLocaleDateString('cs-CZ');
const cls = (v: number | null) => (v == null ? '' : v >= 0 ? 'up' : 'down');
const windows = [
  { key: 'r1', label: '1 měsíc' },
  { key: 'r3', label: '3 měsíce' },
  { key: 'r6', label: '6 měsíců' },
  { key: 'r12', label: '12 měsíců' },
] as const;
const isCrypto = row.group === 'Krypto';
const isUcits = !isCrypto && row.ticker.includes('.');
---
<Base title={`${row.name} (${row.ticker}) – To hýbe trhy`} description={meta.description}>
  <nav class="crumbs">
    <a href={row.backHref}>← {row.backLabel}</a>
  </nav>

  <header class="etf-head">
    <h1>{row.name}</h1>
    <p class="chips">
      <span class="chip">{row.ticker}</span>
      <span class="chip">{row.currency}</span>
      {meta.category && <span class="chip">{meta.category}</span>}
      {meta.region && <span class="chip">{meta.region}</span>}
      {row.benchmark && <span class="chip">benchmark</span>}
    </p>
  </header>

  {meta.description && <p class="desc">{meta.description}</p>}

  <div class="facts">
    {meta.provider && <div class="fact"><span class="k">Správce</span><span class="v">{meta.provider}</span></div>}
    {meta.index && <div class="fact"><span class="k">Index</span><span class="v">{meta.index}</span></div>}
    <div class="fact"><span class="k">Měna fondu</span><span class="v">{row.currency}</span></div>
    <div class="fact"><span class="k">Typ</span><span class="v">{isCrypto ? 'Spotový kurz (není ETF)' : isUcits ? 'UCITS (evropský fond)' : 'US-listed ETF'}</span></div>
  </div>

  <section class="momentum">
    <h2>Aktuální momentum <span class="upd">k {updated}</span></h2>
    <div class="stats">
      {windows.map((w) => (
        <div class="stat">
          <span class="label">{w.label}</span>
          <span class={`value ${cls(row[w.key])}`}>{fmtPct(row[w.key])}</span>
        </div>
      ))}
      <div class="stat">
        <span class="label">Signál (vs 52t průměr)</span>
        {row.signal === 'above' && <span class="badge good">▲ nad průměrem</span>}
        {row.signal === 'below' && <span class="badge bad">▼ pod průměrem</span>}
        {row.signal === null && <span class="value">–</span>}
      </div>
    </div>
  </section>

  {!isUcits && !isCrypto && !row.benchmark && (
    <p class="note">
      Americká ETF nejsou kvůli regulaci PRIIPs běžně dostupná evropským
      retailovým investorům – na tomto webu slouží především jako indikátor.
    </p>
  )}
  {isUcits && (
    <aside class="cta">
      UCITS fond dostupný u brokerů působících v ČR, např.
      <a href="/go/ibkr/" rel="sponsored">Interactive Brokers</a>
      (provizní odkaz).
    </aside>
  )}

  <Methodology>
    <p>
      Momentum = klouzavý výnos za 1, 3, 6 a 12 měsíců (4/13/26/52 týdnů)
      z týdenních cen v měně fondu, s reinvesticí dividend (adjusted close).
      Signál porovnává aktuální cenu s 52týdenním klouzavým průměrem.
      Data: Yahoo Finance, aktualizace týdně. Nejde o investiční doporučení.
    </p>
  </Methodology>

  <style>
    .crumbs { margin: 0.5rem 0 1rem; }
    .crumbs a { color: var(--accent); text-decoration: none; font-size: 0.88rem; }
    .etf-head h1 { font-size: 1.55rem; margin: 0 0 0.4rem; }
    .chips { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0; }
    .chip {
      font-size: 0.75rem; font-weight: 600; padding: 0.15rem 0.6rem;
      border: 1px solid var(--border); border-radius: 999px;
      background: var(--surface-1); color: var(--text-secondary);
    }
    .desc { color: var(--text-secondary); max-width: 46rem; font-size: 1rem; }

    .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.6rem; margin: 1.2rem 0; }
    .fact {
      padding: 0.6rem 0.9rem; background: var(--surface-1);
      border: 1px solid var(--border); border-radius: var(--radius);
    }
    .fact .k { display: block; font-size: 0.72rem; color: var(--text-muted); }
    .fact .v { font-size: 0.92rem; font-weight: 600; }

    .momentum h2 { font-size: 1.15rem; margin: 1.6rem 0 0.7rem; }
    .upd { font-size: 0.78rem; font-weight: 400; color: var(--text-muted); }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.6rem; }
    .stat {
      padding: 0.8rem 1rem; background: var(--surface-1);
      border: 1px solid var(--border); border-radius: var(--radius);
    }
    .stat .label { display: block; font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.2rem; }
    .stat .value { font-size: 1.25rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .up { color: var(--delta-up); }
    .down { color: var(--delta-down); }
    .badge { display: inline-block; padding: 0.15rem 0.55rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; }
    .badge.good { color: var(--delta-up); background: var(--badge-good-bg); }
    .badge.bad { color: var(--delta-down); background: var(--badge-bad-bg); }

    .note { font-size: 0.85rem; color: var(--text-secondary); margin-top: 1rem; }
    .cta {
      margin-top: 1.2rem; padding: 0.9rem 1.1rem; font-size: 0.9rem;
      background: var(--surface-1); border: 1px solid var(--border);
      border-radius: var(--radius); color: var(--text-secondary);
    }
    .cta a { color: var(--accent); }
  </style>
</Base>
