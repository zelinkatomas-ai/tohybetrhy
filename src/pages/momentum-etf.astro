---
import Base from '../layouts/Base.astro';
import LineChart from '../components/LineChart.astro';
import MomentumTable from '../components/MomentumTable.astro';
import Methodology from '../components/Methodology.astro';
import momentumEtfs from '../data/momentum_etfs.json';
import factor from '../data/factor.json';
import factors from '../data/factors.json';

const f = factor as any;
const ratioLast = f.ratio?.series?.[0]?.values?.at(-1) ?? null;
const valueLeads = (f.weeks_below ?? 0) > 0;

// souboj faktorů: vedoucí faktor dle 3M + teploměr rizika (beta vs volatilita)
const fac = factors as any;
const facRows = fac?.rows ?? [];
const facLead = facRows.find((r: any) => !r.benchmark && r.r3 != null) ?? null;
const leadName = facLead ? facLead.name.split(' (')[0] : null;
const leadVerb = facLead?.ticker === 'IWM' ? 'jsou' : 'je';
const hb = facRows.find((r: any) => r.ticker === 'SPHB');
const lv = facRows.find((r: any) => r.ticker === 'USMV');
const betaGap = hb?.r3 != null && lv?.r3 != null ? hb.r3 - lv.r3 : null;
---
<Base title="Momentum ETF – To hýbe trhy" description="Jak se daří ETF postaveným na momentum faktoru proti širokému trhu – a kontrariánský teploměr momentum vs hodnota jako systém včasného varování.">
  <h1>Momentum ETF vs široký trh</h1>
  <p class="lead">
    Momentum se dá koupit i jako balíček – ETF, která faktor systematicky
    sledují. Tady vidíte, jestli svou práci dělají: kompletní přehled včetně
    evropského a emerging markets momenta, v grafu proti S&P 500 a MSCI World
    (čárkovaně). Kliknutím na název otevřete detail fondu.
  </p>

  <MomentumTable data={momentumEtfs} title="Momentum ETF a benchmarky" />

  <LineChart
    title="Momentum ETF vs benchmarky od 1. 1. 2024 (indexováno na 100)"
    note={momentumEtfs.note}
    dates={momentumEtfs.chart.dates}
    series={momentumEtfs.chart.series}
  />

  {facRows.length > 0 && (
    <>
      <h2 class="sub">Souboj faktorů: kdo právě vládne trhu</h2>
      <p class="lead">
        Momentum je jen jeden z „faktorů“ – mechanických pravidel výběru
        akcií, o kterých výzkum ví, že dlouhodobě nesou prémii. Každé vede
        v jiné fázi cyklu: růst a vysoká beta v euforii, kvalita a nízká
        volatilita v nejistotě, malé firmy při oživení, hodnota po výprodejích.
        Stejná mechanika jako u regionů a sektorů: výnosy, signál vůči
        52týdennímu průměru, benchmark čárkovaně.
      </p>
      {facLead && (
        <p class="factor-verdict calm">
          Nejsilnějším faktorem posledních tří měsíců {leadVerb} {leadName}
          {' '}({facLead.r3 >= 0 ? '+' : ''}{facLead.r3.toLocaleString('cs-CZ', { maximumFractionDigits: 1 })} %).
          {betaGap != null && betaGap > 2 && ' Vysoká beta poráží nízkou volatilitu – trh má chuť riskovat.'}
          {betaGap != null && betaGap < -2 && ' Nízká volatilita poráží vysokou betu – kapitál couvá do klidu.'}
        </p>
      )}
      <MomentumTable data={factors} title="Žebříček faktorů (řazeno podle 3M)" />
      {fac.chart && (
        <LineChart
          title="Vybrané faktory vs S&P 500 od 1. 1. 2024 (indexováno na 100)"
          note="V grafu pětice s největší vypovídací hodnotou (momentum, růst, malé firmy a protipóly vysoká beta / nízká volatilita); kompletní žebříček je v tabulce."
          dates={fac.chart.dates}
          series={fac.chart.series}
        />
      )}
    </>
  )}

  {f.perf && (
    <>
      <h2 class="sub">Momentum vs. hodnota: kontrariánská pojistka</h2>
      <p class="lead">
        Čistě „anti-momentum“ ETF na trhu prakticky neexistuje – a to samo
        o sobě je cenná informace. Fond, který systematicky sázel proti
        momentu (QuantShares MOM), zavřel pro chronickou ztrátovost; kdo chce
        být kontrarián pořád, dlouhodobě platí. Nejbližší investovatelný
        kontrarián je <strong>value faktor</strong>: kupuje to, co je levné,
        protože to zrovna nikdo nechce.
      </p>
      <p class="lead">
        Poměr obou faktorů je proto užitečný jako <strong>systém včasného
        varování pro momentum samotné</strong>. Momentum má známou achillovku
        – „momentum crash“: když se trh otočí, nejvíc rostou právě loňští
        poražení (2009, rotace 2020/21) a trendové strategie dostávají
        největší výprask. Chvíle, kdy hodnota začne systematicky porážet
        momentum, je signál „režim se možná mění, věř trendovým tabulkám
        míň“. Nekupujeme tedy kontrariánský produkt, ale sledujeme
        kontrariánský signál – jediná forma kontrariánství, která momentum
        web posiluje, místo aby ho popírala.
      </p>

      {ratioLast != null && (
        <p class={`factor-verdict ${valueLeads ? 'warn' : 'calm'}`}>
          {valueLeads
            ? `Hodnota aktuálně poráží momentum – poměr faktorů je ${f.weeks_below} ${f.weeks_below === 1 ? 'týden' : f.weeks_below < 5 ? 'týdny' : 'týdnů'} v kuse pod svým půlročním průměrem.`
            : 'Momentum aktuálně vede – poměr faktorů se drží nad svým půlročním průměrem, žádné kontrariánské varování.'}
        </p>
      )}

      <LineChart
        title="Momentum (MTUM) vs hodnota (VTV) od 1. 1. 2024 (indexováno na 100)"
        note="Dva pohledy na stejný americký trh – liší se jen pravidlem výběru akcií: momentum kupuje, co roste, hodnota to, co je levné."
        dates={f.perf.dates}
        series={f.perf.series}
      />
      {f.ratio && (
        <LineChart
          title="Poměr momentum / hodnota vs 26týdenní průměr"
          note="Rostoucí čára = momentum vede (normální stav). Pokles pod čárkovaný průměr = hodnota přebírá vedení – historicky časté varování před změnou režimu trhu."
          dates={f.ratio.dates}
          series={f.ratio.series}
        />
      )}
    </>
  )}

  <Methodology>
    <p>
      Sledujeme nejvýznamnější ETF postavená na momentum faktoru: americká
      (SPMO, MTUM, XSMO, FMTM), mezinárodní (IDMO), evropské UCITS (IEMO)
      a emerging markets (PIE, EEMO). Benchmarky SPY a URTH ukazují, jestli
      momentum výběr přidává hodnotu proti prostému držení trhu.
    </p>
    <p>
      Souboj faktorů: velká americká faktorová ETF (momentum MTUM, hodnota
      VTV, růst VUG, malé firmy IWM, kvalita QUAL, nízká volatilita USMV,
      vysoká beta SPHB, dividendy VYM) proti S&P 500, řazeno podle
      tříměsíčního výnosu. Každý fond je jen aproximace faktoru – jiný index,
      jiná pravidla vážení – proto volíme záměrně široké varianty. Rozestup
      dvojice vysoká beta vs nízká volatilita čteme jako teploměr chuti
      riskovat. Faktory se střídají pomalu; nudná tabulka je normální stav.
    </p>
    <p>
      Momentum vs. hodnota: poměr týdenních cen MTUM (iShares MSCI USA
      Momentum Factor) a VTV (Vanguard Value), indexováno na 100
      k 1. 1. 2024, proti 26týdennímu klouzavému průměru poměru. Mechanické
      pravidlo: poměr pod průměrem = hodnota vede; věta ve shrnutí na hlavní
      stránce se generuje až po čtyřech týdnech v kuse, jeden týden je šum.
      V klidu indikátor mlčí. Nejde o investiční doporučení.
    </p>
    <p>
      Nohou hodnoty je záměrně široké VTV (stovky titulů), ne koncentrovaný
      MSCI Enhanced Value (VLUE): v úzkém fondu dokáže pár těžkých pozic
      utrhnout poměr od stylu k příběhu jednotlivých akcií. Přesně to se
      stalo v roce 2026 – VLUE udělalo přes +70 % za rok, zatímco široká
      hodnota (VTV, IVE) okolo +20 %, a indikátor by tak hlásil drtivou
      porážku momenta, která se stylově nekonala. Po revizi proto měříme
      styl proti stylu.
    </p>
    <p>
      Výnosy v měně fondu, momentum jako klouzavý výnos za 1/3/6/12 měsíců
      z týdenních cen. Pozor na krátkou historii FMTM (fond vznikl v roce
      2024). Americká ETF nejsou kvůli regulaci PRIIPs běžně dostupná
      evropským retailovým investorům – zde slouží především jako indikátor
      toho, jak se faktoru daří.
    </p>
  </Methodology>
</Base>

<style>
  h1 { font-size: 1.6rem; margin: 0.5rem 0 0.25rem; }
  .sub { font-size: 1.25rem; margin: 2.2rem 0 0.25rem; }
  .lead { color: var(--text-secondary); margin-top: 0; }
  .lead + .lead { margin-top: 0.6rem; }
  .factor-verdict {
    padding: 0.7rem 1rem; font-size: 0.92rem; font-weight: 600;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface-1);
  }
  .factor-verdict.calm { color: var(--delta-up); background: var(--badge-good-bg); }
  .factor-verdict.warn { color: var(--delta-down); background: var(--badge-bad-bg); }
</style>
