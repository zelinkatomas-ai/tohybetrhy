---
import Base from '../layouts/Base.astro';
import LineChart from '../components/LineChart.astro';
import MomentumTable from '../components/MomentumTable.astro';
import Methodology from '../components/Methodology.astro';
import regions from '../data/regions.json';
import regionsEurope from '../data/regions_europe.json';
import regionsAsia from '../data/regions_asia.json';
import regionsNA from '../data/regions_north_america.json';
import regionsLatam from '../data/regions_latam.json';
---
<Base title="Momentum regionů – To hýbe trhy" description="Momentum světových akciových regionů: svět, USA, Evropa, rozvíjející se trhy, Čína, Indie, Japonsko a další.">
  <h1>Momentum regionů</h1>
  <p class="lead">
    Geografická mapa momenta: čtyři hlavní regiony v grafu a rozšířený rozpad
    na Čínu, Indii, Japonsko, Jižní Ameriku a Afriku v tabulce. Kliknutím na
    název otevřete detail podkladového ETF.
  </p>

  <MomentumTable data={regions} title="Momentum podle regionů" />

  <LineChart
    title="Hlavní regiony od 1. 1. 2024 (indexováno na 100)"
    note="Čtyři hlavní regiony přes UCITS ETF, výnosy v měně fondu."
    dates={regions.chart.dates}
    series={regions.chart.series}
  />

  {regionsEurope.rows.length > 0 && (
    <>
      <h2 class="sub">Evropa v detailu</h2>
      <p class="lead">
        Rozpad evropského regionu na jednotlivé země – kde uvnitř Evropy
        momentum skutečně vzniká. Řazeno podle tříměsíčního výnosu.
      </p>
      <MomentumTable data={regionsEurope} title="Momentum evropských zemí" />
    </>
  )}

  {regionsAsia.rows.length > 0 && (
    <>
      <h2 class="sub">Asie v detailu</h2>
      <p class="lead">
        Od velké trojky (Čína, Indie, Japonsko) po menší trhy. Tchaj-wan
        a Korea jsou zároveň teploměrem čipového cyklu.
      </p>
      <MomentumTable data={regionsAsia} title="Momentum asijských zemí" />
    </>
  )}

  {regionsNA.rows.length > 0 && (
    <>
      <h2 class="sub">Severní Amerika v detailu</h2>
      <p class="lead">
        USA a Kanada vedle sebe – kanadský trh je těžký na banky, energii
        a těžaře, takže rozestup vůči USA často kopíruje komoditní cyklus.
      </p>
      <MomentumTable data={regionsNA} title="Momentum Severní Ameriky" />
    </>
  )}

  {regionsLatam.rows.length > 0 && (
    <>
      <h2 class="sub">Latinská Amerika v detailu</h2>
      <p class="lead">
        Rozpad jihoamerického regionu (plus Mexiko). Venezuela chybí záměrně –
        nemá investovatelný trh ani ETF.
      </p>
      <MomentumTable data={regionsLatam} title="Momentum Latinské Ameriky" />
    </>
  )}

  <Methodology>
    <p>
      Momentum měříme jako klouzavý výnos za 1, 3, 6 a 12 měsíců (4/13/26/52
      týdnů) z týdenních cen ETF reprezentujících jednotlivé regiony, v měně
      fondu. Signál „nad/pod průměrem“ porovnává aktuální cenu s 52týdenním
      klouzavým průměrem – mechanické pravidlo absolutního momenta.
    </p>
    <p>
      Kde existuje kvalitní UCITS fond, používáme ten (svět, USA, Evropa,
      rozvíjející se trhy, Indie, Japonsko, Německo, Francie, V. Británie).
      Pro menší trhy slouží jako indikátor likvidnější americká ETF; Afriku
      zastupuje jihoafrický trh, protože širší africké ETF na trhu prakticky
      neexistuje. Česko v tabulce chybí záměrně: likvidní ETF na český trh
      neexistuje a index PX není v našem bezplatném datovém zdroji dostupný.
      Měnový přepočet záměrně neděláme – přidával by k trendu regionu šum
      měnového páru. Zlato a dluhopisy zatím nesledujeme; web se soustředí na
      akciové momentum.
    </p>
  </Methodology>
</Base>

<style>
  h1 { font-size: 1.6rem; margin: 0.5rem 0 0.25rem; }
  .sub { font-size: 1.25rem; margin: 2.2rem 0 0.25rem; }
  .lead { color: var(--text-secondary); max-width: 46rem; margin-top: 0; }
</style>
