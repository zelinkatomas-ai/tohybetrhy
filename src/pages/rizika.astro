---
import Base from '../layouts/Base.astro';
import LineChart from '../components/LineChart.astro';
import Methodology from '../components/Methodology.astro';
import risks from '../data/risks.json';
import polymarket from '../data/polymarket.json';

const r = risks as any;
const bets = (polymarket as any).geopolitics ?? null;
const fmtVol = (v: number) =>
  v >= 1e6 ? `${(v / 1e6).toLocaleString('cs-CZ', { maximumFractionDigits: 1 })} mil. $`
           : `${Math.round(v / 1e3).toLocaleString('cs-CZ')} tis. $`;
---
<Base title="Rizika – To hýbe trhy" description="Kvantifikovaná geopolitika: novinový index GPR, nejistota z hospodářské politiky (EPU) a jak zbrojení oceňuje trh.">
  <h1>Rizika</h1>
  <p class="lead">
    Geopolitika se dá měřit – ne pocitem z titulků, ale mechanicky: kolik
    prostoru zabírá napětí v novinách (GPR), jak velká je nejistota kolem
    hospodářské politiky (EPU) a jak strukturální riziko oceňuje trh přes
    obranný sektor. Důležitý kontext: čisté geopolitické šoky trhy většinou
    vstřebají rychleji, než se čeká – tyhle teploměry jsou kontext
    k momentu a likviditě, ne důvod k panice.
  </p>

  {r.gpr && (
    <LineChart
      title="Geopolitické napětí: index GPR"
      note="Podíl novinových článků o geopolitickém napětí v 10 velkých světových denících (Caldara–Iacoviello, akademický standard). Týdenní průměr denní řady. Klíčové je srovnání s ročním klouzavým průměrem – úrovní, na kterou si trhy zvykly; čárkovaně dlouhodobý průměr pro historický kontext."
      dates={r.gpr.dates}
      series={r.gpr.series}
    />
  )}
  {r.epu && (
    <LineChart
      title="Nejistota z hospodářské politiky: index EPU (USA)"
      note="Baker–Bloom–Davis: novinový index nejistoty kolem cel, sankcí, daní a rozpočtů. Doplněk ke GPR – obchodní válka se projeví tady dřív než v geopolitickém indexu. Týdenní průměr denní řady z FREDu, roční klouzavý průměr jako aktuální normál; čárkovaně průměr od 2015."
      dates={r.epu.dates}
      series={r.epu.series}
    />
  )}
  {r.defense && (
    <LineChart
      title="Trh hlasuje: obranný sektor vs S&P 500"
      note="Poměr ceny obranných ETF k S&P 500, indexováno na 100 na začátku grafu (evropská řada od startu EUAD v říjnu 2024). Trvalý růst poměru = trh oceňuje strukturální zbrojení, bez ohledu na jednotlivé titulky."
      dates={r.defense.dates}
      series={r.defense.series}
    />
  )}

  {bets?.length > 0 && (
    <section class="bets">
      <h2>Sázkové trhy: geopolitika</h2>
      <p class="note">
        Nejobchodovanější otevřené geopolitické otázky na Polymarketu –
        pravděpodobnosti oceněné skutečnými penězi sázkařů. Výběr je čistě
        mechanický (objem za 24 hodin), týdenní snímek; živé kurzy po
        prokliku.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Otázka</th><th>Odpověď trhu</th><th class="num">Šance</th><th class="num">Objem 24 h</th></tr>
          </thead>
          <tbody>
            {bets.map((b: any) => (
              <tr>
                <td class="q">{b.url ? <a href={b.url} rel="nofollow noopener" target="_blank">{b.question}</a> : b.question}</td>
                <td>{b.outcome}</td>
                <td class="num prob">{b.prob.toLocaleString('cs-CZ', { maximumFractionDigits: 0 })} %</td>
                <td class="num">{fmtVol(b.volume24h)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <Methodology>
    <p>
      <strong>GPR (Geopolitical Risk Index):</strong> Dario Caldara a Matteo
      Iacoviello (Fed) počítají od roku 1900 podíl článků o geopolitickém
      napětí – válkách, hrozbách, terorismu – v 10 velkých denících. Index
      je standardem akademické literatury; denní řadu autoři publikují
      zdarma. Ukazujeme týdenní průměr proti dlouhodobému průměru celé
      dostupné řady.
    </p>
    <p>
      <strong>EPU (Economic Policy Uncertainty):</strong> stejná novinová
      metoda pro nejistotu z hospodářské politiky (cla, sankce, daně,
      rozpočtové krize). Denní řadu pro USA přebíráme z FREDu. GPR a EPU se
      doplňují: horká válka zvedá první, obchodní druhé.
    </p>
    <p>
      <strong>Obranný sektor vs trh:</strong> relativní síla ETF ITA (americká
      obrana a letectví) a EUAD (evropská obrana) vůči S&P 500. Novinové
      indexy měří slova; tenhle poměr měří peníze – kam trh dlouhodobě
      přeceňuje riziko, tam teče kapitál do zbrojení.
    </p>
    <p>
      <strong>Polymarket:</strong> sázkové trhy oceňují pravděpodobnosti
      konkrétních událostí penězi – historicky bývají přesnější než průzkumy
      i experti, protože omyl něco stojí. Výběr otázek je mechanický
      (nejvyšší objem s geopolitickými tagy), takže se sám obměňuje s děním;
      šance = cena kontraktu. Makro otázky (sazby, recese) najdete na
      stránce <a href="/likvidita/">Likvidita</a>.
    </p>
    <p>
      <strong>Jak to číst:</strong> výzkum opakovaně ukazuje, že izolované
      geopolitické šoky mají na akciové trhy krátkodobý dopad a rychle
      odeznívají; dlouhodobě škodí až jejich přeliv do inflace, sazeb
      a likvidity. Proto tuhle stránku čtěte spolu se stránkou
      <a href="/likvidita/">Likvidita</a> – a věta o rizicích se do vzkazu
      na hlavní stránce propisuje jen při výrazné eskalaci.
    </p>
  </Methodology>
</Base>

<style>
  h1 { font-size: 1.6rem; margin: 0.5rem 0 0.25rem; }
  .lead { color: var(--text-secondary); max-width: 46rem; margin-top: 0; }

  .bets { margin: 2rem 0; }
  .bets h2 { font-size: 1.2rem; margin: 0 0 0.35rem; }
  .bets .note { margin: 0 0 0.75rem; font-size: 0.85rem; color: var(--text-secondary); max-width: 46rem; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  th, td { padding: 0.55rem 0.7rem; text-align: left; border-bottom: 1px solid var(--gridline); }
  th { color: var(--text-muted); font-weight: 600; font-size: 0.8rem; white-space: nowrap; }
  th.num, td.num { text-align: right; white-space: nowrap; }
  td.prob { font-weight: 600; }
  td.q a { color: var(--text-primary); text-decoration: none; border-bottom: 1px dotted var(--baseline); }
  td.q a:hover { color: var(--accent); border-bottom-color: var(--accent); }
</style>
