# Analytika Umami (https://umami.is) – bez vyplnění se žádný měřicí skript nenačítá.
# Snippet se navíc vkládá jen do produkčního buildu (npm run build), ne při vývoji.
#
# PUBLIC_UMAMI_URL        ... adresa vaší Umami instance, bez lomítka na konci
#                             (self-host, např. https://analytics.tohybetrhy.cz,
#                              nebo cloud: https://cloud.umami.is)
# PUBLIC_UMAMI_WEBSITE_ID ... UUID webu z Umami (Settings -> Websites -> Edit)

PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_WEBSITE_ID=
